{
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "tsBuildInfoFile": ".tscache",
    "target": "es6",
    "module": "amd",
    "rootDir": "./",
    "allowUmdGlobalAccess": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "controllers/**/*.ts",
    "modules/**/*.ts"
  ]
}